#!/bin/sh

echo "Running Maven tests and Checkstyle before push..."

mvn clean verify
if [ $? -ne 0 ]; then
    echo "ERROR: Maven verification failed. Push aborted."
    exit 1
fi

mvn checkstyle:check "-Dcheckstyle.config.location=config/checkstyle/checkstyle.xml"
if [ $? -ne 0 ]; then
    echo "ERROR: Checkstyle failed. Push aborted."
    exit 1
fi

echo "All checks passed. Push allowed."
exit 0